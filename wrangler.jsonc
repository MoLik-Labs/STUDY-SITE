// Cloudflare Workers — cấu hình DUY NHẤT cho bản deploy (Workers Static Assets).
//
// Deploy: `npx wrangler deploy` (dist/ đã được commit; `npm run build` dựng lại).
// Workers Builds: Build command để trống, Deploy command `npx wrangler deploy`.
//
// Biến môi trường (Settings → Variables and Secrets trên Workers, KHÔNG để trong repo):
//   SUPABASE_URL                 https://<ref>.supabase.co          (tuỳ chọn)
//   SUPABASE_PUBLISHABLE_KEY     sb_publishable_…                   (tuỳ chọn)
// Thiếu một trong hai thì app chạy ở chế độ khách, không lỗi.
// Khoá bí mật (sb_secret_, service_role) bị Worker từ chối, không bao giờ phục vụ.
{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",

  "name": "foxfocus",
  "compatibility_date": "2026-11-01",

  // Điểm vào động duy nhất. Chỉ hai đường dẫn chạy mã Worker trước tài nguyên tĩnh;
  // mọi tệp tĩnh khác được phục vụ trước và không tốn lượt gọi Worker.
  "main": "./dist/_worker.mjs",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Đường dẫn lạ trả đúng 404.html thay vì đoán mò.
    "not_found_handling": "404-page",
    // /index.html → /, /tai-khoan/index.html → /tai-khoan/.
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/__version", "/assets/config.js"]
  },

  "workers_dev": true,
  "preview_urls": true,

  // Workers Builds chạy `npx wrangler preview` trên nhánh không phải production;
  // lệnh này cần khối `previews` (có thể rỗng).
  "previews": {}

  // Tên miền riêng: bỏ comment, sửa tên miền (cần đã trỏ nameserver về Cloudflare).
  // "routes": [{ "pattern": "study.ten-mien-cua-ban.com", "custom_domain": true }]
}
