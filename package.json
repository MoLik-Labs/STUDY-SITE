{
  "name": "study-focus-fox",
  "version": "12.0.0",
  "private": true,
  "description": "Web tự học mọi thứ: Vật lí 9 & luyện thi chuyên Lý, trường học lớp 1-12, thời khoá biểu, kế hoạch, lịch, phòng thí nghiệm — tất cả trong một tệp HTML chạy offline.",
  "keywords": [
    "vat-ly",
    "vat-li-9",
    "study",
    "timetable",
    "calendar",
    "flashcards",
    "offline",
    "single-file",
    "vietnamese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoLik-Labs/STUDY-SITE.git"
  },
  "author": "Study Focus Fox <@its.fox_> (https://github.com/MoLik-Labs/STUDY-SITE)",
  "license": "MIT",
  "scripts": {
    "build": "node site/build.mjs",
    "prepare": "node site/build.mjs",
    "check": "node --test site/test/*.test.mjs",
    "test": "node site/build.mjs --out /tmp/sf-test-dist && node --test site/test/*.test.mjs",
    "serve": "node site/test/serve.mjs --port 8124",
    "deploy": "node site/build.mjs && npx wrangler deploy",
    "preview": "node site/build.mjs && npx wrangler dev"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
