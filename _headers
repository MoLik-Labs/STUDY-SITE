# Cloudflare Pages — sinh tự động bởi src/build.py, đừng sửa tay.
# Cú pháp: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Trang chính: luôn xác thực lại với máy chủ (ETag/304) để người dùng
# nhận bản mới ngay khi deploy, nhưng vẫn không tải lại toàn bộ tệp.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Tệp có băm nội dung trong tên: cache vĩnh viễn
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/.well-known/*
  Content-Type: text/plain; charset=utf-8

# Kết quả kiểm tra cho /__version (Pages Functions)
/__version
  Cache-Control: no-store
